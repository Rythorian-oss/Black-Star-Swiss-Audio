<Window x:Class="BlackStarSwissAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:BlackStarSwissAudio.Controls"
        xmlns:vm="clr-namespace:BlackStarSwissAudio.ViewModels"
        Title="Black Star Swiss Audio" Icon="pack://application:,,,/Assets/BlackStarSwissAudio.ico" Width="1440" Height="880" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowDrop="True"
        Background="{StaticResource Obsidian}" Foreground="{StaticResource Bone}" FontFamily="Segoe UI"
        Drop="OnDrop" DragOver="OnDragOver" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources><BooleanToVisibilityConverter x:Key="B2V"/></Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Lattice}" BorderBrush="{StaticResource MetalEdge}" BorderThickness="2" Padding="3">
        <Border BorderBrush="#4475D6D0" BorderThickness="1" Background="{StaticResource Obsidian}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#E00A0E14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Background="#FF101820" Padding="4" Margin="0,0,11,0">
                        <Image Source="{StaticResource Sigil}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BLACK STAR  /  SWISS AUDIO" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="Light" Foreground="{StaticResource BrassLight}"/>
                        <TextBlock Text="A U D I O   E N G I N E   ·   S T U D I O   0 1" FontSize="8" Foreground="{StaticResource Signal}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Lament.Btn}" Content="—" Click="OnMin" Width="44" Margin="0"/>
                    <Button Style="{StaticResource Lament.Btn}" Content="▢" Click="OnMax" Width="44" Margin="0"/>
                    <Button Style="{StaticResource Lament.Btn}" Content="✕" Click="OnClose" Width="44" Margin="0"/>
                </StackPanel>
            </Grid>

            <!-- Transport -->
            <Border Grid.Row="1" Background="#F011151C" BorderBrush="{StaticResource GoldDim}" BorderThickness="0,1,0,1">
                <DockPanel Margin="10,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Btn}" Content="Import" Command="{Binding ImportCommand}" ToolTip="Import audio or video files"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Btn}" Content="{Binding VoiceButtonText}" Command="{Binding VoiceCommand}" ToolTip="Start or stop UK English voice commands" AutomationProperties.Name="Toggle voice commands"/>
                    <ProgressBar DockPanel.Dock="Left" Width="48" Height="8" Maximum="1" Value="{Binding VoiceInputLevel, Mode=OneWay}" VerticalAlignment="Center" ToolTip="Live microphone input level" AutomationProperties.Name="Voice microphone input level"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Btn}" Content="Open" Command="{Binding OpenProjectCommand}" ToolTip="Open a saved project or audio/video files"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Btn}" Content="Save" Command="{Binding SaveProjectCommand}" ToolTip="Save project and track settings"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Transport}" Content="●" Foreground="{StaticResource Blood}" Command="{Binding RecordCommand}" ToolTip="Record / finish" AutomationProperties.Name="Record or finish recording"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Transport}" Content="▶" Command="{Binding PlayCommand}" ToolTip="Play" AutomationProperties.Name="Play"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Transport}" Content="⏸" Command="{Binding PauseCommand}" ToolTip="Pause" AutomationProperties.Name="Pause"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Lament.Transport}" Content="■" Command="{Binding StopCommand}" ToolTip="Stop" AutomationProperties.Name="Stop"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="8,0"/>
                    <Slider DockPanel.Dock="Left" Width="140" Minimum="0" Maximum="{Binding MixDurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Seek playback position" AutomationProperties.Name="Playback position"/>
                    <CheckBox DockPanel.Dock="Left" Content="Loop" IsChecked="{Binding LoopEnabled}" VerticalAlignment="Center" Margin="6,0" AutomationProperties.Name="Loop selected time range"/>
                    <ProgressBar DockPanel.Dock="Left" Width="140" Height="10" Maximum="1" Value="{Binding Level}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Export Video" Command="{Binding ExportVideoCommand}" ToolTip="Mux the edited mix into the selected video track's picture (needs FFmpeg)"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Export Audio" Command="{Binding ExportCommand}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Bounce Mix" Command="{Binding BounceCommand}" ToolTip="Mix all tracks into a new track"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource B2V}}"/>
                </DockPanel>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Row="2" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ToolsColumnWidth, Mode=OneWay}" MinWidth="0"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="{Binding FxColumnWidth, Mode=OneWay}" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Tools -->
                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="10" Margin="0,0,4,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Lament.Header}" Text="35 AUDIO TOOLS  ·  drag onto a track"/>
                        <ListBox x:Name="ToolList" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Lament.Item}" PreviewMouseLeftButtonDown="ToolList_Down" PreviewMouseMove="ToolList_Move">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Foreground="{StaticResource Gold}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SignalDim}" ShowsPreview="True" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" AutomationProperties.Name="Resize tools panel"/>

                <!-- Timeline -->
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="10" Margin="0,0,4,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lament.Header}" Text="THE TIMELINE  ·  drop audio / video files anywhere"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <ToggleButton Content="Tools" IsChecked="{Binding ToolsCollapsed}" ToolTip="Collapse or show the tools panel" AutomationProperties.Name="Toggle tools panel" Margin="2"/>
                                                            <ToggleButton Content="FX" IsChecked="{Binding FxCollapsed}" ToolTip="Collapse or show the FX panel" AutomationProperties.Name="Toggle FX panel" Margin="2"/>
                                    <CheckBox Content="Diag" IsChecked="{Binding DiagnosticsEnabled}" VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="Toggle performance diagnostics"/>
                                    <Button Style="{StaticResource Lament.Btn}" Content="Cache" Command="{Binding CacheInfoCommand}" ToolTip="Show cache and temporary-file usage" Padding="6,2"/>
                                    <Button Style="{StaticResource Lament.Btn}" Content="Clear" Command="{Binding ClearCacheCommand}" ToolTip="Clear downloaded cache files" Padding="6,2"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Fit" Command="{Binding FitTimelineCommand}" ToolTip="Fit the entire project" Padding="7,2"/>
                                <TextBlock DockPanel.Dock="Left" Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10"/>
                                <Slider Minimum="1" Maximum="16" Value="{Binding TimelineZoom}" Width="130" VerticalAlignment="Center" ToolTip="Timeline zoom" AutomationProperties.Name="Timeline zoom"/>
                                <TextBlock DockPanel.Dock="Left" Text="Scroll" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="10"/>
                                <Slider Minimum="0" Maximum="{Binding MixDurationSeconds}" Value="{Binding TimelineStartSeconds}" Width="150" VerticalAlignment="Center" ToolTip="Pan across the timeline" AutomationProperties.Name="Timeline horizontal scroll"/>
                            </DockPanel>
                            <ctl:TimelineRuler Height="24" ViewSeconds="{Binding TimelineViewSeconds}" ViewStartSeconds="{Binding TimelineStartSeconds}" PlaybackSeconds="{Binding PositionSeconds}"/>
                            <Border Height="158" Margin="0,6,0,8" BorderBrush="{StaticResource SignalDim}" BorderThickness="1" Background="#FF080D13" Padding="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lament.Header}" Text="{Binding SpectrogramCaption}" Margin="0"/>
                                    </DockPanel>
                                    <ctl:SpectrogramView LiveColumn="{Binding SpectrogramLiveColumn}" ClipToBounds="True"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <ListBox x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Lament.Item}" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackVM}">
                                    <Border x:Name="TrackSurface" Height="128" Background="{StaticResource Lacquer}" BorderThickness="0,0,0,1" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="✕" Padding="6,0" Margin="0"
                                                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="Remove track"/>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Lament.Toggle}" Content="S" IsChecked="{Binding Solo}" ToolTip="Solo track" AutomationProperties.Name="Solo track"/>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Lament.Toggle}" Content="M" IsChecked="{Binding Mute}" ToolTip="Mute track" AutomationProperties.Name="Mute track"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Info}" FontSize="10" Foreground="{StaticResource Ash}"/>
                                            <DockPanel Margin="0,4,0,0"><TextBlock Text="Gain" Width="34" FontSize="10"/><Slider Minimum="-30" Maximum="12" Value="{Binding GainDb}" AutomationProperties.Name="Track gain"/></DockPanel>
                                            <DockPanel><TextBlock Text="Pan" Width="34" FontSize="10"/><Slider Minimum="-1" Maximum="1" Value="{Binding Pan}" AutomationProperties.Name="Track pan"/></DockPanel>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock Text="Peak" Width="34" FontSize="10" VerticalAlignment="Center"/>
                                                <ProgressBar Value="{Binding MeterPeak, Mode=OneWay}" Maximum="1" Height="10" Width="72" VerticalAlignment="Center" AutomationProperties.Name="Track peak meter"/>
                                                <TextBlock Text="RMS" FontSize="9" Margin="5,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding MeterRms, StringFormat={}{0:F2}}" FontSize="9" VerticalAlignment="Center"/>
                                                <TextBlock Text="CLIP" Foreground="{StaticResource Blood}" FontSize="9" FontWeight="Bold" Margin="5,0,0,0" Visibility="{Binding IsClipping, Converter={StaticResource B2V}}"/>
                                            </DockPanel>
                                            <DockPanel><TextBlock Text="Start s" Width="44" FontSize="10" VerticalAlignment="Center"/><TextBox Text="{Binding Offset, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="60" HorizontalAlignment="Left" AutomationProperties.Name="Track start offset in seconds"/><TextBlock Text="{Binding UndoDescription}" FontSize="9" Foreground="{StaticResource Ash}" Margin="4,0" VerticalAlignment="Center"/></DockPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#FF0D0D10" BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
                                            <ctl:WaveformView Peaks="{Binding Peaks}" Channels="{Binding Buffer.Channels}" OffsetSeconds="{Binding Offset}" ClipSeconds="{Binding Buffer.Seconds}" ViewSeconds="{Binding DataContext.TimelineViewSeconds, RelativeSource={RelativeSource AncestorType=Window}}" ViewStartSeconds="{Binding DataContext.TimelineStartSeconds, RelativeSource={RelativeSource AncestorType=Window}}" PlaybackSeconds="{Binding DataContext.PositionSeconds, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                    </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Mute}" Value="True"><Setter TargetName="TrackSurface" Property="Opacity" Value="0.58"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Solo}" Value="True"><Setter TargetName="TrackSurface" Property="BorderBrush" Value="{StaticResource Gold}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SignalDim}" ShowsPreview="True" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" AutomationProperties.Name="Resize FX panel"/>

                <!-- Parameters + FX -->
                <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <TextBlock Style="{StaticResource Lament.Header}" Text="PARAMETERS"/>
                            <TextBlock Text="{Binding ToolDescription}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Ash}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Track speed" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0"/>
                                <ComboBox SelectedValue="{Binding SelectedSpeed}" SelectedValuePath="Content" Width="74" AutomationProperties.Name="Track speed preset">
                                    <ComboBoxItem Content="0.5×"/><ComboBoxItem Content="0.75×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="1.25×"/><ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/>
                                </ComboBox>
                                <Button Style="{StaticResource Lament.Btn}" Content="Set speed" Command="{Binding ApplySpeedCommand}" Padding="6,2"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="MP3 bitrate" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"/>
                                <ComboBox SelectedIndex="{Binding ExportBitrateIndex}" Width="92" AutomationProperties.Name="MP3 export bitrate">
                                    <ComboBoxItem Content="128 kbps" Tag="128000"/><ComboBoxItem Content="192 kbps" Tag="192000"/><ComboBoxItem Content="256 kbps" Tag="256000"/>
                                </ComboBox>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Params}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value, StringFormat=N2}" Foreground="{StaticResource Gold}" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding Label}" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}"
                                                    TickFrequency="{Binding Tick}" IsSnapToTickEnabled="{Binding Snap}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource Lament.Btn}" Content="Apply" Command="{Binding ApplyCommand}" Background="#FF2A1114"/>
                                <Button Style="{StaticResource Lament.Btn}" Content="Preview" Command="{Binding PreviewCommand}" ToolTip="Preview the selected effect without changing the track"/>
                                <Button Style="{StaticResource Lament.Btn}" Content="Undo" Command="{Binding UndoCommand}"/>
                                <Button Style="{StaticResource Lament.Btn}" Content="Redo" Command="{Binding RedoCommand}"/>
                            </UniformGrid>
                            <DockPanel Margin="0,5,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Trim" Command="{Binding TrimSelectionCommand}" ToolTip="Keep the selected time range on the current track"/>
                                <CheckBox Content="Snap 0.1s" IsChecked="{Binding SnapSelection}" VerticalAlignment="Center" Margin="2"/>
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Selection s" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding SelectedStart, UpdateSourceTrigger=PropertyChanged}" Width="54" AutomationProperties.Name="Selection start in seconds"/>
                                <TextBox Text="{Binding SelectedEnd, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="4,0,0,0" AutomationProperties.Name="Selection end in seconds"/>
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="Loop s" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding LoopStart, UpdateSourceTrigger=PropertyChanged}" Width="54" AutomationProperties.Name="Loop start in seconds"/>
                                <TextBox Text="{Binding LoopEnd, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="4,0,0,0" AutomationProperties.Name="Loop end in seconds"/>
                            </DockPanel>
                            <Separator Margin="0,10" Background="{StaticResource GoldDim}"/>
                            <DockPanel>
                                <TextBlock Style="{StaticResource Lament.Header}" Text="FX LIBRARY  ·  built-in + your audio"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FxLibraryUsage}" FontSize="10" Foreground="{StaticResource Ash}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Add audio" Command="{Binding AddLocalFxCommand}" ToolTip="Add audio files to the selected local category" Padding="7,3"/>
                                <TextBlock Text="Save to" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding UserFxCategories}" SelectedItem="{Binding UserFxCategory}" ToolTip="Choose the local folder for imported audio" AutomationProperties.Name="Save FX in category"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Create folder" Command="{Binding CreateFxCategoryCommand}" Padding="7,3" ToolTip="Create a new local FX category folder"/>
                                <TextBox Text="{Binding NewFxCategoryName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New FX category name" AutomationProperties.Name="New FX category name"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Mend Join" Command="{Binding MendJoinCommand}" Padding="7,3" ToolTip="Join the selected track to its neighbor and blend the selected FX sound across the splice"/>
                                <ComboBox ItemsSource="{Binding FxCategories}" SelectedItem="{Binding FxCategory}" ToolTip="Filter the FX library" AutomationProperties.Name="FX category filter"/>
                            </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="Optional online FX: download by URL or browse sources" FontSize="10" Foreground="{StaticResource Ash}" Margin="0,6,0,2"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Lament.Btn}" Content="Get" Command="{Binding DownloadFxCommand}" Margin="4,0,0,0"/>
                                <TextBox Text="{Binding FxUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding FxSources}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Lament.Btn}" Content="{Binding Name}" ToolTip="{Binding Note}" Margin="0,1" Padding="6,3" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ListBox x:Name="FxList" ItemsSource="{Binding FilteredFxItems}" SelectedItem="{Binding SelectedFx}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Lament.Item}" MouseDoubleClick="FxList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Ash}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Status -->
            <Border Grid.Row="3" Background="#F010151B" BorderBrush="{StaticResource GoldDim}" BorderThickness="0,1,0,0">
                <DockPanel Margin="10,0">
                    <ProgressBar DockPanel.Dock="Right" Width="140" Height="8" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource B2V}}" Foreground="{StaticResource Signal}"/>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Signal}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticsText}" FontSize="10" Foreground="{StaticResource Signal}" VerticalAlignment="Center" Margin="10,0"/>
                </DockPanel>
            </Border>
        </Grid>
        </Border>
    </Border>
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>
</Window>
